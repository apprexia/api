// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid())

  email  String  @unique
  name   String?
  avatar String?

  // Nombre de crédits disponibles
  credits   Int      @default(2)
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analyses        Analysis[]
  favorites       Favorite[]
  transactions    CreditTransaction[]
  ProjectEstimate ProjectEstimate?
}

enum UserRole {
  USER
  ADMIN
}

model CreditTransaction {
  id              String                @id @default(uuid())
  userId          String
  amount          Int
  type            CreditTransactionType
  stripeSessionId String?               @unique
  packageId       String?
  description     String?
  createdAt       DateTime              @default(now())
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum CreditTransactionType {
  WELCOME
  ANALYSIS
  PURCHASE
  REFUND
  ADMIN
}

model Analysis {
  id         String  @id @default(uuid())
  status     String  @default("PENDING")
  userId     String
  sourceSite String?
  url        String

  typeLocal  String?
  title      String?
  city       String?
  codePostal String?
  dvfKey     String?

  dpe String?
  ges String?

  codeInsee        String?
  communeContext   Json?
  communeAnalysis  Json?
  rooms            Int?
  bedrooms         Int?
  floor            Int?
  constructionYear Int?
  surface          Float?
  terrain          Float?
  score            Int?
  scoreExplanation String?

  verdict            String?
  verdictExplanation String?

  dvfReferenceValue Float?

  estimatedValueLow  Float?
  estimatedValueHigh Float?

  askingPrice      Float?
  recommendedPrice Float?

  negotiationAmount    Float?
  negotiationPotential Int?
  negotiationAnalysis  String?

  marketPosition   String?
  marketAdjustment String?

  location  Json?
  amenities Json?
  riskLevel Int?

  grossYield    Float?
  yieldLevel    String?
  yieldAnalysis String?

  estimatedRentMonthly Float?
  estimatedRentLow     Float?
  estimatedRentHigh    Float?
  rentPerSquareMeter   Float?
  rentConfidence       Float?

  monthlyCashflow Float?
  annualCashflow  Float?

  description String?
  imageUrl    String?

  strengths String[]
  risks     String[]

  analysisConfidence Float?
  engine             Json?

  createdAt DateTime @default(now())

  user                      User              @relation(fields: [userId], references: [id])
  Favorite                  Favorite[]
  communeIndicator          CommuneIndicator? @relation(fields: [communeIndicatorCodeInsee], references: [codeInsee])
  communeIndicatorCodeInsee String?

  @@index([city])
  @@index([codePostal])
  @@index([city, codePostal])
}

enum AnalysisStatus {
  SCRAPING
  SCRAPING_FAILED
  SCRAPED
  AI_PROCESSING
  COMPLETED
  AI_FAILED
  INSUFFICIENT_DATA
  UNSUPPORTED_PROPERTY_TYPE
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  analysisId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@unique([userId, analysisId])
}

model DvfTransaction {
  id             String    @id @default(cuid())
  mutationId     String    @unique
  dateMutation   DateTime?
  year           Int?
  city           String?
  codePostal     String?
  typeLocal      String
  surface        Float
  pieces         Int?
  valeurFonciere Float
  prixM2         Float
  createdAt      DateTime  @default(now())

  @@index([city])
  @@index([codePostal])
  @@index([typeLocal])
  @@index([city, typeLocal])
  @@index([city, codePostal])
  @@index([year, city])
  @@index([year, city, typeLocal])
}

model RentalMarket {
  id               Int            @id @default(autoincrement())
  zoneId           Int?
  year             Int
  inseeCode        String
  city             String
  departmentCode   String
  regionCode       String
  propertyType     PropertyType
  roomCategory     RoomCategory
  rentMedianM2     Float
  rentLowM2        Float
  rentHighM2       Float
  predictionType   PredictionType
  observations     Int
  observationsArea Int
  adjustedR2       Float
  createdAt        DateTime       @default(now())

  @@unique([year, inseeCode, propertyType, roomCategory])
  @@index([inseeCode])
  @@index([city])
}

enum PropertyType {
  APARTMENT
  HOUSE
}

enum RoomCategory {
  ALL
  ONE_TWO
  THREE_PLUS
}

enum PredictionType {
  COMMUNE
  MAILLE
}

model CommuneIndicator {
  codeInsee       String  @id
  commune         String
  codeDepartement String?
  region          String?

  // Population
  population                Int?
  evolutionPopulation5Years Float?

  // Immobilier commune
  medianPriceM2          Float?
  medianHousePriceM2     Float?
  medianApartmentPriceM2 Float?
  dvfTransactions        Int?
  priceEvolution5Years   Float?

  // Energie
  dpeAB        Float?
  passoiresDpe Float?

  // Services
  schoolIndex   Float?
  fiberCoverage Float?
  doctorAccess  Float?

  // Risques
  icpeSurface   Float?
  sevesoSurface Float?
  floodRisk     Float?

  // Fiscalité
  propertyTaxRate Float?
  propertyTaxM2   Float?

  // Score calculé plus tard
  localScore Float?

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  Analysis  Analysis[]

  @@index([commune])
  @@index([codeDepartement])
}

model LocationCache {
  id String @id @default(uuid())

  city       String
  codePostal String
  radius     Int

  latitude  Float
  longitude Float

  data Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([city, codePostal, latitude, longitude, radius])
}

model ProjectEstimate {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  monthlyIncome  Int
  monthlyCredits Int @default(0)
  downPayment    Int @default(0)
  householdSize  Int @default(1)
  loanDuration   Int

  borrowingCapacity Int
  monthlyPayment    Int
  minBudget         Int
  maxBudget         Int
  targetBudget      Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
